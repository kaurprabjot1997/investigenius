# Copy to .env and fill in. Never commit the real .env.

# "anthropic" (live, dev laptop with API access) | "gateway" (bank enterprise
# LLM endpoint, once confirmed) | "cache" (offline replay — default for the
# bank laptop until/unless gateway access is confirmed)
LLM_PROVIDER=cache

# Required only when LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Required only when LLM_PROVIDER=gateway
GATEWAY_BASE_URL=
GATEWAY_API_KEY=
GATEWAY_MODEL=
